#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	$(MAKE) all CFLAGS="$(shell dpkg-buildflags --get CFLAGS)" LDFLAGS="$(shell dpkg-buildflags --get LDFLAGS)" \
		CPPFLAGS="$(shell dpkg-buildflags --get CPPFLAGS)"

override_dh_auto_install:
	$(MAKE) install-desktop DESTDIR=$(CURDIR)/debian/tenwin-desktop PREFIX=/usr
	$(MAKE) install-greeter DESTDIR=$(CURDIR)/debian/tenwin-greeter PREFIX=/usr

override_dh_auto_test:
	# The Python tests need a GTK stack; run "make check" in a desktop session.
