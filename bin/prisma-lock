#!/bin/sh
# prisma-lock – Sperrt den Bildschirm in den Farben der aktiven Facette
PRISMA_LIB="${PRISMA_LIB:-@LIBDIR@}"
# Im Quellbaum (nicht installiert) das Repository selbst verwenden
[ -d "$PRISMA_LIB/prisma" ] || PRISMA_LIB="$(dirname "$(readlink -f "$0")")/.."
export PYTHONPATH="$PRISMA_LIB${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m prisma.lock "$@"
